# The server reads these from the process environment; it does not load this file.
# TfL API key (https://api-portal.tfl.gov.uk). Optional locally.
TFL_APP_KEY=
# Enables /mcp and is typed at the OAuth login. Generate with: openssl rand -hex 32
MCP_SECRET=
# Public origin for OAuth URLs when not on Railway (Railway sets RAILWAY_PUBLIC_DOMAIN).
PUBLIC_URL=
# Realtime Trains API token (https://api-portal.rtt.io) for live National Rail departures. Optional.
RTT_TOKEN=
# Directory on persistent storage for saved places, preferences and followed journeys. Unset, they are lost on restart.
DATA_DIR=
