#!/usr/bin/env bash
# tube <session> list [page]               -> the server's instructions and tool definitions, a page at a time
# tube <session> call <tool> '<json args>' -> call a tool
set -euo pipefail
session="$1"; kind="$2"
if [ "$kind" = "list" ]; then
  body=$(python3 -c 'import json,sys; print(json.dumps({"session":sys.argv[1],"kind":"list","page":int(sys.argv[2]) if len(sys.argv)>2 and sys.argv[2] else 1}))' "$session" "${3:-1}")
else
  body=$(python3 -c 'import json,sys; print(json.dumps({"session":sys.argv[1],"kind":"call","tool":sys.argv[2],"args":json.loads(sys.argv[3]) if len(sys.argv)>3 and sys.argv[3] else {}}))' "$session" "$3" "${4:-}") || { echo '{"isError":true,"error":"arguments are not valid JSON"}'; exit 0; }
fi
curl -sS --noproxy 127.0.0.1 -X POST -H 'Content-Type: application/json' -d "$body" http://127.0.0.1:4600/
echo
