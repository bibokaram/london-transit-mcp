#!/usr/bin/env bash
set -euo pipefail
session="$1"; kind="$2"
case "$kind" in
  list)  body=$(python3 -c 'import json,sys; print(json.dumps({"session":sys.argv[1],"kind":"list","page":int(sys.argv[2]) if len(sys.argv)>2 and sys.argv[2] else 1}))' "$session" "${3:-1}") ;;
  reply) body=$(python3 -c 'import json,sys; print(json.dumps({"session":sys.argv[1],"kind":"reply","n":sys.argv[2],"text":sys.argv[3]}))' "$session" "$3" "${4:-}") ;;
  state) body=$(python3 -c 'import json,sys; print(json.dumps({"session":sys.argv[1],"kind":"state"}))' "$session") ;;
  *)     body=$(python3 -c 'import json,sys; print(json.dumps({"session":sys.argv[1],"kind":"call","tool":sys.argv[2],"args":json.loads(sys.argv[3]) if len(sys.argv)>3 and sys.argv[3] else {}}))' "$session" "$3" "${4:-}") || { echo '{"isError":true,"error":"arguments are not valid JSON"}'; exit 0; } ;;
esac
curl -sS --noproxy 127.0.0.1 -X POST -H 'Content-Type: application/json' -d "$body" http://127.0.0.1:4603/
echo
